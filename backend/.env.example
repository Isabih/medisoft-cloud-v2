# Medisoft v4 - MacBook backend example (never commit backend/.env)
# Based on existing Medisoft configuration; secrets intentionally omitted.
# Background collectors and runtime DDL are disabled by default.
# API endpoints may still write; use read-only DB credentials for development.

APP_NAME=Medisoft Monitoring Backend
API_V1_PREFIX=/api/v1
SECRET_KEY=REPLACE_WITH_NEW_LONG_RANDOM_SECRET

# VPN address of existing cloud server. Direct MySQL requires a listener and
# grants that allow VPN access. Prefer SSH tunnel if MySQL is loopback-only:
# ssh -N -L 3307:127.0.0.1:3306 clinic
# DATABASE_URL=mysql+pymysql://DEV_READONLY_USER:REPLACE_PASSWORD@127.0.0.1:3307/central_monitoring
# Do not use root or the production account from a development workstation.
DATABASE_URL=mysql+pymysql://DEV_READONLY_USER:REPLACE_PASSWORD@100.76.128.122:3306/central_monitoring

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
AUTO_CREATE_TABLES=false
ENABLE_BACKGROUND_COLLECTORS=false
ALLOW_RUNTIME_SCHEMA_MIGRATIONS=false

# Legacy source DB settings (only configure if this feature is required).
# The source MySQL host is NOT necessarily the cloud server's VPN address.
MYSQL_SOURCE_HOST=127.0.0.1
MYSQL_SOURCE_USER=REPLACE_WITH_SOURCE_USER
MYSQL_SOURCE_PASSWORD=REPLACE_WITH_SOURCE_PASSWORD

# SMS (Intouch Rwanda) - bootstrap values, can be changed in Settings.
INTOUCH_API_URL=https://intouchsms.co.rw
INTOUCH_USERNAME=
INTOUCH_PASSWORD=
INTOUCH_SENDER_ID=MEDISOFT
ADMIN_PHONE_NUMBERS=

# Lovable AI Gateway (optional)
LOVABLE_API_KEY=

# Grafana (optional; localhost means the MacBook, not the cloud server)
GRAFANA_BASE_URL=http://localhost:3000

# Email alerts (Resend) - verified sending domain required
RESEND_API_KEY=
ALERT_EMAIL_FROM=Medisoft Guardian <alerts@YOUR_VERIFIED_DOMAIN>
ADMIN_EMAILS=

# Monitoring retention
RETENTION_DAYS=7

# Existing database integrity settings
CHECK_TABLE_NAME=address
CHECK_TIME_COLUMN=updated_at

# v4 monitoring administration; never expose this in frontend VITE_* vars.
MEDISOFT_MONITORING_ADMIN_TOKEN=REPLACE_WITH_UNIQUE_RANDOM_TOKEN_AT_LEAST_32_CHARS

# v4 IO recovery currently uses SMTP; RESEND_API_KEY does not yet power
# this specific recovery sender. Leave SMTP blank unless explicitly configured.
MEDISOFT_RECOVERY_EMAIL_TO=
MEDISOFT_SMTP_HOST=
MEDISOFT_SMTP_PORT=587
MEDISOFT_SMTP_FROM=
MEDISOFT_SMTP_USER=
MEDISOFT_SMTP_PASSWORD=

# v4 storage: preserve existing receiver root and <database>_data folders.
# Cloud paths are not local MacBook paths. Do not create or scan them on Mac.
BACKUP_ROOT=/srv/health-center-manual-dump
HOURLY_BACKUP_DIR=/srv/health-center-manual-dump
NIGHTLY_BACKUP_DIR=/srv/health-center-manual-dump/nightly
EXPORT_DIR=/srv/health-center-manual-dump/exports
BACKUP_METADATA_DIR=/srv/health-center-manual-dump/metadata
CLOUD_STATUS_FILE=/opt/monitoring/cloud_status.json
HOURLY_BACKUP_INTERVAL_MINUTES=60
HOURLY_BACKUP_RETENTION_COUNT=1
NIGHTLY_BACKUP_RETENTION_COUNT=1
EXPORT_EXPIRY_MINUTES=60
EXPORT_DELETE_AFTER_DOWNLOAD=true
BACKUP_COMPRESSION=zstd
BACKUP_VERIFY_CHECKSUM=true
REPORT_TIMEZONE=Africa/Kigali
NIGHTLY_BACKUP_TIME=00:00
DAILY_REPORT_TIME=01:00
# Keep jobs disabled until receiver isolation, authorization and storage are tested.
ENABLE_NIGHTLY_BACKUPS=false
ENABLE_DATABASE_EXPORTS=false
ENABLE_EXPORT_CLEANUP=false
ENABLE_DAILY_EMAIL_REPORT=false
