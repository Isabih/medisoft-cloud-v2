# Medisoft v4 backend — copy to backend/.env and edit locally.
# Confirmed production backend variable names (2026-11-23):
# DATABASE_URL, SECRET_KEY, API_V1_PREFIX, BACKEND_HOST, BACKEND_PORT.
# Their actual values have NOT been inspected and are intentionally not included.
# The additional variables below are optional development/v4 settings.
# NEVER commit real passwords, API tokens, or production connection strings.
#
# CLOUD DATABASE MODE (development workstation -> existing cloud MySQL):
# IMPORTANT: the v4 backend starts collectors that write monitoring metadata.
# Do NOT point this development branch at the live production DB until
# collector startup and DB privileges have been isolated and reviewed.
# 1. Connect to your private VPN/Tailscale.
# 2. Use a dedicated, least-privileged monitoring database account.
# 3. Replace CLOUD_DB_HOST, CLOUD_DB_NAME and CLOUD_DB_USER below with real values.
# 4. URL-encode special characters in passwords inside DATABASE_URL.
#
# For local MySQL testing instead, replace DATABASE_URL with:
# DATABASE_URL=mysql+pymysql://local_monitor_user:REPLACE_PASSWORD@127.0.0.1:3306/medisoft_monitor_dev
#
# Do not point an untested development collector at production with write permissions.
DATABASE_URL=mysql+pymysql://CLOUD_DB_USER:REPLACE_PASSWORD@CLOUD_DB_HOST:3306/CLOUD_DB_NAME
SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET
API_V1_PREFIX=/api/v1
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8004
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Use false when connecting to existing cloud data; schema changes require review.
AUTO_CREATE_TABLES=false

# Legacy source DB configuration; replace if that feature is used.
MYSQL_SOURCE_HOST=127.0.0.1
MYSQL_SOURCE_USER=REPLACE_SOURCE_USER
MYSQL_SOURCE_PASSWORD=REPLACE_SOURCE_PASSWORD

# Independent monitoring admin API token (>=32 chars).
# Never put this token in a VITE_* variable or browser code.
MEDISOFT_MONITORING_ADMIN_TOKEN=REPLACE_WITH_UNIQUE_RANDOM_TOKEN_AT_LEAST_32_CHARS

# Email on verified IO recovery (optional; disabled until configured).
# These are NOT present in the currently inspected production .env.
# Add them only when notification delivery is ready to test.
MEDISOFT_RECOVERY_EMAIL_TO=
MEDISOFT_SMTP_HOST=
MEDISOFT_SMTP_PORT=587
MEDISOFT_SMTP_FROM=
MEDISOFT_SMTP_USER=
MEDISOFT_SMTP_PASSWORD=
